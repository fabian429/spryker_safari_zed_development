{% extends '@Gui/Layout/layout.twig' %}

{% set widget_title = 'Edit Antelope Location' | trans %}

{% block head_title widget_title | trans %}
{% block section_title widget_title | trans %}
{% block action %}
    {{ backActionButton(backUrl, 'Back to antelope location list' | trans) }}
{% endblock %}

{% block content %}
    {% embed '@Gui/Partials/widget.twig' %}
        {% block widget_content %}
            {{ form_start(antelopeLocationEditForm) }}

            {% for field in antelopeLocationEditForm.children %}
                {{ form_row(field) }}
            {% endfor %}

            <input type="submit" class="btn btn-primary safe-submit"
                   value="{{ 'Save' | trans }}"/>

            {{ form_end(antelopeLocationEditForm) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
