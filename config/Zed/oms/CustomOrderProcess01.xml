<?xml version="1.0"?>
<statemachine
xmlns="spryker:oms-01"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="spryker:oms-01 http://static.spryker.com/oms-01.xsd">

    <process name="CustomOrderProcess01" main="true">
        <states>
            <state name="new" />
            <state name="paid" />
            <state name="shipped" />
            <state name="canceled" />
            <state name="closed" />
        </states>

        <transitions>
            
            <transition happy="true" condition="CustomOrder/IsPaymentAuthorized">
                <source>new</source>
                <target>paid</target>
                <event>authorize_payment</event>
            </transition>

            <transition happy="true">
                <source>paid</source>
                <target>shipped</target>
                <event>ship_order</event>
            </transition>

            <transition happy="true">
                <source>shipped</source>
                <target>closed</target>
                <event>confirm_shipment</event>
            </transition>

            <transition>
                <source>new</source>
                <target>canceled</target>
                <event>cancel_order</event>
            </transition>

        </transitions>

        <events>
            <event name="authorize_payment" manual="true" command="CustomOrder/AuthorizePayment" />
            <event name="ship_order" manual="true" command="CustomOrder/ShipOrder" />
            <event name="confirm_shipment" manual="true" />
            <event name="cancel_order" manual="true" />
        </events>
    </process>
</statemachine>